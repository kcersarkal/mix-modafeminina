# Supabase (obrigatório para exibir produtos)
# Project URL e anon key: painel do Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# URL pública do site (usada em sitemap, canonical, robots e Open Graph)
# Ex.: https://mix-modafeminina.vercel.app
NEXT_PUBLIC_SITE_URL=localhost:3000

# Opcional: verificação do Google Search Console
GOOGLE_SITE_VERIFICATION=
